# Web panel login (required)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
PORT=8080
# Extra origins allowed to use the panel (comma-separated), e.g. when opened through a reverse proxy
ALLOWED_ORIGINS=https://nvrrec.kip.tm,http://nvrrec.kip.tm
# Where config, database and local recordings live
# Docker: host folder mounted at /data in the container
DATA_PATH=/mnt/st/nvr_recorder
# Without Docker: folder used directly by the app
DATA_DIR=./data
